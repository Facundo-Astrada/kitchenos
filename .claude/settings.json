{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${SUPABASE_MANAGEMENT_TOKEN}",
        "--project-ref",
        "clipcxcbtlibswfzsgzk"
      ],
      "env": {
        "SUPABASE_MANAGEMENT_TOKEN": "${SUPABASE_MANAGEMENT_TOKEN}"
      }
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "vercel-mcp@latest"],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx next *)",
      "Bash(npx vercel *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"c:/Users/Equipo/Documents/kitchenos\" && npx tsc --noEmit 2>&1 | grep -E \"error TS\" | head -5 || echo \"✓ TypeScript OK\""
          }
        ]
      }
    ]
  }
}
