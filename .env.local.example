# ================================================================
# Variables de entorno — KitchenOS
# Copiar este archivo como .env.local y completar los valores.
# .env.local NUNCA se sube a git.
# ================================================================

# ── Supabase (requerido para que la app funcione) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── IA (requerido para recetas con IA) ────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── MCPs para Claude Code (opcional — mejora el desarrollo) ───
# Estos tokens permiten que Claude Code controle Supabase, Vercel y GitHub
# directamente sin copiar/pegar. Ver instrucciones en .claude/setup-mcp.ps1
#
# SUPABASE_MANAGEMENT_TOKEN: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=sbp_your-management-token
#
# VERCEL_TOKEN: https://vercel.com/account/tokens (scope: Full Account)
VERCEL_TOKEN=your-vercel-token
#
# GITHUB_PERSONAL_ACCESS_TOKEN: https://github.com/settings/tokens/new (scopes: repo, read:user)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-github-token
